# Database Connection (SQLite by default for zero-friction local run)
DATABASE_URL="file:./dev.db"

# Optional: Real PostgreSQL connection string if preferred
# DATABASE_URL="postgresql://user:password@localhost:5432/commercepilot?schema=public"

# AI Provider API Keys (Optional: works out-of-the-box in Heuristic / Fallback mode if unset)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Razorpay Integration (Optional: works out-of-the-box in Demo Simulation Mode)
RAZORPAY_KEY_ID="rzp_test_demo_commercepilot"
RAZORPAY_KEY_SECRET="demo_secret_not_real"

# App Environment
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEMO_MODE="true"
